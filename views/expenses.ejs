<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expenses</title>
    <link rel="stylesheet" href="dashboard.css" />
  </head>
  <body>
    <%- include("_dashheader.ejs") %>
    <main>
      <%- include("_dashnav.ejs") %>
      <section class="main-content">
        <div class="section-header">
          <h2>Expenses</h2>
          <span class="total-badge">Total: KSh <%= Number(total).toLocaleString() %></span>
        </div>

        <div class="page-form">
          <h3>Record New Expense</h3>
          <form action="/expenses" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="expense_date">Date <span class="required">*</span></label>
                <input type="date" id="expense_date" name="expense_date" required />
              </div>
              <div class="form-group">
                <label for="expense_type">Type <span class="required">*</span></label>
                <select id="expense_type" name="expense_type" required>
                  <option value="Feeds">Feeds</option>
                  <option value="Vaccination">Vaccination</option>
                  <option value="Medication">Medication</option>
                  <option value="Maintenance">Maintenance</option>
                  <option value="Labor">Labor</option>
                  <option value="Insemination">Insemination</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="amount">Amount (KSh) <span class="required">*</span></label>
                <input type="number" step="0.01" min="0" id="amount" name="amount" required />
              </div>
            </div>
            <div class="form-group">
              <label for="description">Description</label>
              <input type="text" id="description" name="description" maxlength="255" />
            </div>
            <button type="submit" class="submit-btn">Add Expense</button>
          </form>
        </div>

        <h3>Expense History</h3>
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Description</th>
              <th>Amount (KSh)</th>
            </tr>
          </thead>
          <tbody>
            <% expenses.forEach(exp => { %>
            <tr>
              <td><%= exp.expense_date %></td>
              <td><%= exp.expense_type %></td>
              <td><%= exp.description %></td>
              <td><%= Number(exp.amount).toLocaleString() %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
