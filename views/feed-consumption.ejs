<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feed Consumption</title>
    <link rel="stylesheet" href="dashboard.css" />
  </head>
  <body>
    <%- include("_dashheader.ejs") %>
    <main>
      <%- include("_dashnav.ejs") %>
      <section class="main-content">
        <div class="section-header">
          <h2>Feed Consumption</h2>
        </div>

        <div class="page-form">
          <h3>Record Feeding</h3>
          <form action="/feed-consumption" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="animalfed">Animal <span class="required">*</span></label>
                <select id="animalfed" name="animalfed" required>
                  <% animals.forEach(animal => { %>
                  <option value="<%= animal.animal_tag %>"><%= animal.animal_tag %> - <%= animal.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label for="type">Feed Type <span class="required">*</span></label>
                <input type="text" id="type" name="type" maxlength="50" required placeholder="e.g. Napier Grass, Dairy Meal" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="quantity">Quantity (kg) <span class="required">*</span></label>
                <input type="number" step="0.01" min="0" id="quantity" name="quantity" required />
              </div>
              <div class="form-group">
                <label for="cost">Cost (KSh) <span class="required">*</span></label>
                <input type="number" step="0.01" min="0" id="cost" name="cost" required />
              </div>
              <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" />
              </div>
            </div>
            <button type="submit" class="submit-btn">Add Record</button>
          </form>
        </div>

        <h3>Recent Feedings</h3>
        <table>
          <thead>
            <tr>
              <th>Tag</th>
              <th>Animal</th>
              <th>Feed Type</th>
              <th>Quantity (kg)</th>
              <th>Cost (KSh)</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% feeds.forEach(feed => { %>
            <tr>
              <td><%= feed.animalfed %></td>
              <td><%= feed.animal_name %></td>
              <td><%= feed.type %></td>
              <td><%= feed.quantity %></td>
              <td><%= Number(feed.cost).toLocaleString() %></td>
              <td><%= String(feed.date).slice(0, 10) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
