<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Farmer Profile</title>
    <link rel="stylesheet" href="dashboard.css" />
  </head>
  <body>
    <%- include("_dashheader.ejs") %>
    <main>
      <%- include("_dashnav.ejs") %>
      <section class="main-content">
        <div class="section-header">
          <h2>Farmer Profile</h2>
        </div>

        <% if (message) { %>
        <div class="flash"><%= message %></div>
        <% } %>

        <div class="page-form">
          <form action="/farmer-profile" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="fullname">Full Name <span class="required">*</span></label>
                <input type="text" id="fullname" name="fullname" maxlength="100" required value="<%= profile.fullname %>" />
              </div>
              <div class="form-group">
                <label for="phone">Phone</label>
                <input type="tel" id="phone" name="phone" value="<%= profile.phone || '' %>" />
              </div>
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" value="<%= profile.email %>" disabled />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="farm_name">Farm Name</label>
                <input type="text" id="farm_name" name="farm_name" maxlength="100" value="<%= profile.farm_name || '' %>" />
              </div>
              <div class="form-group">
                <label for="county">County</label>
                <input type="text" id="county" name="county" maxlength="100" value="<%= profile.county || '' %>" />
              </div>
            </div>
            <div class="form-group">
              <label for="farm_location">Farm Location</label>
              <input type="text" id="farm_location" name="farm_location" maxlength="255" value="<%= profile.farm_location || '' %>" />
            </div>
            <p>Member since: <%= String(profile.registration_date).slice(0, 10) %></p>
            <button type="submit" class="submit-btn">Save Profile</button>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>
