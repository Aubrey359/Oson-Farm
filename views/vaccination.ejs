<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaccination Records</title>
    <link rel="stylesheet" href="dashboard.css" />
  </head>
  <body>
    <%- include("_dashheader.ejs") %>
    <main>
      <%- include("_dashnav.ejs") %>
      <section class="main-content">
        <div class="section-header">
          <h2>Vaccination Records</h2>
        </div>

        <div class="page-form">
          <h3>Record Vaccination</h3>
          <form action="/vaccination" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="animal_id">Animal <span class="required">*</span></label>
                <select id="animal_id" name="animal_id" required>
                  <% animals.forEach(animal => { %>
                  <option value="<%= animal.animal_tag %>"><%= animal.animal_tag %> - <%= animal.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label for="vaccine_name">Vaccine <span class="required">*</span></label>
                <input type="text" id="vaccine_name" name="vaccine_name" maxlength="100" required placeholder="e.g. FMD, Anthrax" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="date_administered">Date Administered <span class="required">*</span></label>
                <input type="date" id="date_administered" name="date_administered" required />
              </div>
              <div class="form-group">
                <label for="next_due_date">Next Due Date</label>
                <input type="date" id="next_due_date" name="next_due_date" />
              </div>
            </div>
            <div class="form-group">
              <label for="notes">Notes</label>
              <input type="text" id="notes" name="notes" maxlength="255" />
            </div>
            <button type="submit" class="submit-btn">Add Vaccination</button>
          </form>
        </div>

        <h3>History</h3>
        <table>
          <thead>
            <tr>
              <th>Tag</th>
              <th>Animal</th>
              <th>Vaccine</th>
              <th>Administered</th>
              <th>Next Due</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <% vaccinations.forEach(vac => { %>
            <tr>
              <td><%= vac.animal_id %></td>
              <td><%= vac.animal_name %></td>
              <td><%= vac.vaccine_name %></td>
              <td><%= vac.date_administered %></td>
              <td><%= vac.next_due_date || "-" %></td>
              <td><%= vac.notes %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
