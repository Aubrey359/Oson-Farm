<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medication Records</title>
    <link rel="stylesheet" href="dashboard.css" />
  </head>
  <body>
    <%- include("_dashheader.ejs") %>
    <main>
      <%- include("_dashnav.ejs") %>
      <section class="main-content">
        <div class="section-header">
          <h2>Medication Records</h2>
        </div>

        <div class="page-form">
          <h3>Record Medication</h3>
          <form action="/medication" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="animal_id">Animal <span class="required">*</span></label>
                <select id="animal_id" name="animal_id" required>
                  <% animals.forEach(animal => { %>
                  <option value="<%= animal.animal_tag %>"><%= animal.animal_tag %> - <%= animal.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label for="medication_name">Medication <span class="required">*</span></label>
                <input type="text" id="medication_name" name="medication_name" maxlength="100" required />
              </div>
              <div class="form-group">
                <label for="dose">Dose</label>
                <input type="text" id="dose" name="dose" maxlength="100" placeholder="e.g. 10ml" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="start_date">Start Date <span class="required">*</span></label>
                <input type="date" id="start_date" name="start_date" required />
              </div>
              <div class="form-group">
                <label for="end_date">End Date</label>
                <input type="date" id="end_date" name="end_date" />
              </div>
              <div class="form-group">
                <label for="veterinary_name">Veterinarian</label>
                <input type="text" id="veterinary_name" name="veterinary_name" maxlength="100" />
              </div>
            </div>
            <div class="form-group">
              <label for="notes">Notes</label>
              <input type="text" id="notes" name="notes" maxlength="255" />
            </div>
            <button type="submit" class="submit-btn">Add Medication</button>
          </form>
        </div>

        <h3>History</h3>
        <table>
          <thead>
            <tr>
              <th>Tag</th>
              <th>Animal</th>
              <th>Medication</th>
              <th>Dose</th>
              <th>Start</th>
              <th>End</th>
              <th>Veterinarian</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <% medications.forEach(med => { %>
            <tr>
              <td><%= med.animal_id %></td>
              <td><%= med.animal_name %></td>
              <td><%= med.medication_name %></td>
              <td><%= med.dose %></td>
              <td><%= med.start_date %></td>
              <td><%= med.end_date || "Ongoing" %></td>
              <td><%= med.veterinary_name %></td>
              <td><%= med.notes %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
